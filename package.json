    "@fullcalendar/timegrid": "^6.1.19",
    "@muyajs/core": "0.2.0",
    "@playwright/test": "^1.63.0",
    "dompurify": "^3.4.5",
    "esbuild": "^0.28.2",
    "force-graph": "^1.51.0",
    "katex": "0.16.47",
    "lightweight-charts": "^5.2.1",
    "mermaid": "11.15.0"
  }
}
