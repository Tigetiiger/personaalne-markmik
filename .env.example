# Copy to .env (never commit .env). Only what the app needs to start; every outside account
# (eKool, Google, brain repo, ntfy) is connected in the app: Seaded → Ühendused.

# Flask session signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The owner's password on first start (later starts ignore it; change it in Seaded).
OWNER_PASSWORD=
# Encrypts stored secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes the stored secrets unreadable (reconnect the accounts).
MARKMIK_KEY=
# Claude Code token from `claude setup-token` (the app's AI runs on this subscription).
CLAUDE_CODE_OAUTH_TOKEN=
