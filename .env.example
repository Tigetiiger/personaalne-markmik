# Copy to .env (never commit .env). Only what the app needs to start; every outside account
# (eKool, Google, brain repo, ntfy) is connected in the app: Seaded → Ühendused.

# Flask session signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The owner's password on first start, as a hash (later starts ignore it; change it in Seaded).
# Generate: uv run python -m app.hashpw
# Keep the single quotes: docker compose would expand the "$" parts of an unquoted value.
OWNER_PASSWORD_HASH=''
# OWNER_PASSWORD=<plain password> still works (development, tests), but leaves the password in
# plain text in .env. With both set, the hash wins.
# Encrypts stored secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes the stored secrets unreadable (reconnect the accounts).
MARKMIK_KEY=
# Claude Code token from `claude setup-token` (the app's AI runs on this subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# Going public through a Cloudflare Tunnel (docs/TUNNEL-PLAN.md, README "Going public"). Leave
# both unset to stay Tailscale-only: docker-compose.yml's `tunnel` profile then never starts.
# Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared -> the token
# shown there (not installed on the host: the cloudflared container runs it).
TUNNEL_TOKEN=
# The tunnel's public hostname, with scheme, no trailing slash. Share links and the ICS feed
# address are built on this so a copied link works for anyone.
PUBLIC_URL=
# Uncomment to start cloudflared with plain `docker compose up -d` (else: --profile tunnel).
# COMPOSE_PROFILES=tunnel

# Meedia (docs/MEEDIA-PLAN.md): the host folder of pictures and videos with their companion
# files, mounted at /meedia. Default ./data/meedia; point it at the bigger disk once there is one.
# MEDIA_HOST_DIR=/srv/meedia
